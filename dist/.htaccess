RewriteEngine On

RewriteRule ^(?:server|api)(?:/|$) - [R=404,L]

RewriteRule ^live-tracking/?$ live-tracking.html [L]
RewriteRule ^faq/?$ faq.html [L]
RewriteRule ^updates/?$ updates.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^participation-terms/?$ participation-terms.html [L]
RewriteRule ^accessibility/?$ accessibility.html [L]
RewriteRule ^the-run/?$ the-run.html [L]
RewriteRule ^will/?$ will.html [L]
RewriteRule ^fifty-runs/?$ fifty-runs.html [L]
RewriteRule ^week-1/?$ week-1.html [L]
RewriteRule ^week-2/?$ week-2.html [L]
RewriteRule ^week-3/?$ week-3.html [L]
RewriteRule ^athletes/?$ athletes.html [L]
RewriteRule ^partners/?$ partners.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/json "access plus 7 days"
  ExpiresByType application/xml "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|mjs|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|svg|woff2|mp4|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
